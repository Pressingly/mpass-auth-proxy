# mpass-auth-proxy configuration
# Copy to .env and fill in. Values below are placeholders, not real credentials.
# Angle-bracket placeholders are quoted so this file stays source-able as-is;
# replace the whole value, quotes included, with the real one.

# --- Required ---------------------------------------------------------------

# OIDC issuer. For AWS Cognito this is the user-pool issuer, NOT the OAuth
# domain — the /token endpoint is resolved from the discovery document.
OIDC_ISSUER_URL="https://cognito-idp.<region>.amazonaws.com/<user-pool-id>"

# OIDC client (app client) id registered with the IdP.
OIDC_CLIENT_ID="<client-id>"

# Moneta hosted UI the browser is redirected to for the QR / implicit flow.
MONETA_HOSTED_UI_URL="https://<moneta-hosted-ui-host>"

# Public URL of this service's /mpass-callback endpoint. The host also derives
# the allowed redirect_uri suffix and the portal URL (see PORTAL_URL below).
MPASS_CALLBACK_URL="https://auth.<platform-domain>/mpass-callback"

# Redis / Valkey connection used for bridge state and one-time auth codes.
REDIS_URL=redis://valkey:6379/10

# Cookie domain for the mpass_bridge cookie — must cover every app subdomain.
COOKIE_DOMAIN=".<platform-domain>"

# RSA signing key for the re-signed id_token and the Buzz NIP-FI assertions.
# Read only when LAUNCHPAD_EMAIL_CAPTURE or BUZZ_ADAPTER_ENABLED is true; with
# both off this service never signs anything and none of these three variables
# is touched. With either on it REFUSES TO START without a key unless
# MPASS_SIGNING_KEY_ALLOW_EPHEMERAL is set: oauth2-proxy and the Buzz relays
# verify against this service's JWKS, so a per-process generated key means each
# restart breaks every outstanding token, and a second replica can never verify
# the first's tokens.
#
# Three sources, read in this order: MPASS_SIGNING_KEY_B64, then the GCP pair,
# then the ephemeral opt-in. Empty means unset, not "use the empty value", so an
# unconfigured variable falls through to the next source.

# Base64 of an unencrypted PEM RSA private key (2048-bit or larger).
MPASS_SIGNING_KEY_B64=

# Alternative source: read the PEM from GCP Secret Manager. Both must be set;
# ignored when MPASS_SIGNING_KEY_B64 is non-empty.
MPASS_SIGNING_KEY_GCP_PROJECT="<gcp-project-id>"
MPASS_SIGNING_KEY_GCP_SECRET="<secret-name>"

# Launchpad database, read-only. Used to resolve a synthetic identity to its
# verified real email before the token is re-signed. When this lookup cannot be
# completed the service returns 503 rather than falling back to the synthetic
# address -- see the email-overlay note in main.py for why.
LAUNCHPAD_DB_HOST=postgres
LAUNCHPAD_DB_PORT=5432
LAUNCHPAD_DB_NAME=launchpad
LAUNCHPAD_DB_USER=mpass_auth_user
LAUNCHPAD_DB_PASSWORD=

# Domain of the synthetic address (<synthetic_id>@<domain>) that unverified
# users are identified by. REQUIRED — the service refuses to start without it.
# Not defaulted on purpose: consumers key identity on the email claim, so a
# different value silently turns every user into a new principal and orphans
# their existing data. Set it to the platform's shared email domain.
SYNTHETIC_EMAIL_DOMAIN="<platform-email-domain>"

# Launchpad email capture. OFF by default -- with this false the service echoes
# the IdP's id_token unchanged and never touches the launchpad database, which
# is how it behaved before the feature existed.
#
# Turning it on is only half a switch: the deployment's oauth2-proxy must be
# pointed at this service's issuer and JWKS in the same change. oauth2-proxy
# verifies every id_token against whichever JWKS it is configured with, so
# re-signing while it still trusts the IdP -- or echoing while it trusts us --
# means no token verifies and nobody can log in to any application.
#
# When true, the service refuses to start without the signing key, the synthetic
# domain and the launchpad database password below.
LAUNCHPAD_EMAIL_CAPTURE=false

# Buzz NIP-FA adapter (Buzz desktop sign-in). OFF by default -- with this false
# no /nip-fa/ route is mounted. When true the service REFUSES TO START unless
# BUZZ_IDENTITY_MASTER_SECRET is exactly 64 hex characters (32 bytes), e.g.
# `openssl rand -hex 32`. It is the root of every custodial Buzz key, so it must
# never change once users have signed in.
BUZZ_ADAPTER_ENABLED=false
BUZZ_IDENTITY_MASTER_SECRET=

# Salt for the custodial Buzz key derivation. Required when the adapter is on:
# hex, 32 to 128 characters (16 to 64 bytes), e.g. `openssl rand -hex 16`. Like
# the master secret it must never change once users have signed in -- either
# change re-keys every user, and issuance then fails with binding_mismatch.
# The adapter also needs LAUNCHPAD_DB_PASSWORD (above): keys are bound in the
# launchpad database's buzz_identities table, created by launchpad-api's schema,
# which must be deployed first.
BUZZ_IDENTITY_SALT=

# Fixed lifetime of a Buzz adapter session, in seconds. Default: 2592000 (30
# days, the Cognito refresh-token cap). Sessions are revalidated hourly.
BUZZ_ADAPTER_SESSION_TTL_SECONDS=2592000

# NIP-FI relay assertions (POST /nip-fa/v1/identity/assertions). With the
# adapter on, the service also loads the signing key described above and serves
# /.well-known/jwks.json, even with LAUNCHPAD_EMAIL_CAPTURE off.
#
# The exact `iss` of every assertion. Required with the adapter on: an https URL
# with no query, fragment or trailing slash, different from
# MPASS_PROXY_ISSUER_URL. Each relay's NIP-FI issuer policy must name this
# string byte for byte, with jwks_uri <adapter origin>/.well-known/jwks.json.
BUZZ_NIP_FI_ISSUER="https://auth.<platform-domain>/nip-fi"

# Relays this adapter issues assertions for, comma-separated. Required with the
# adapter on. Canonical form only: wss://host[:port], lowercase, default port
# omitted, no port 80, no trailing slash, path, query or fragment. A
# non-canonical entry refuses startup. Each assertion's aud is https:// plus the
# relay's authority (wss://chat.example.com -> https://chat.example.com), which
# must be that relay community's configured audience.
BUZZ_RELAY_URLS="wss://<relay-host>"

# Assertion lifetime in seconds, 30 to 3600. Default: 300. Never later than the
# adapter session's expiry. Must not exceed the relay's
# maximum_assertion_age_seconds for BUZZ_NIP_FI_ISSUER, or the relay rejects it.
BUZZ_ASSERTION_TTL_SECONDS=300

# Public origin Buzz clients reach this service on, https://host[:port] with no
# path or trailing slash. The NIP-98 proof's `u` tag must equal
# <origin>/nip-fa/v1/identity/assertions exactly. Default: the origin of
# MPASS_CALLBACK_URL. Set it only when the adapter is served on another host.
BUZZ_ADAPTER_PUBLIC_ORIGIN=

# NIP-FA agent keys (POST /nip-fa/v1/nip-fi/agent-grant, agent-assertion,
# agent-revoke). Keep it OFF until owner revocation ships: grants outlive an
# offboarded owner's sessions until they expire (README, "Buzz agent keys").
# OFF by default, read only with BUZZ_ADAPTER_ENABLED on: with it
# off the three routes answer 403 agent_unsupported and nothing below is read.
# With it on, the service REFUSES TO START unless BUZZ_RELAY_INTERNAL_URLS and
# BUZZ_COMMAND_PRINCIPAL are set and valid. Enrollments are stored in launchpad's
# buzz_agents table, so deploy launchpad-api's schema first.
BUZZ_AGENTS_ENABLED=false

# Where each relay's NIP-FI disconnect API is reached from this service, one per
# BUZZ_RELAY_URLS entry, in the same order: http(s)://host[:port] with no path or
# trailing slash. Revoking an agent POSTs a signed command to
# <internal url>/api/nip-fi/disconnect on every relay.
BUZZ_RELAY_INTERNAL_URLS=

# The `sub` of those disconnect commands. Must appear in each relay's
# authorized_principals for BUZZ_NIP_FI_ISSUER. Up to 2048 bytes, no whitespace.
BUZZ_COMMAND_PRINCIPAL=

# The `aud` of each relay's disconnect command, one https value per
# BUZZ_RELAY_URLS entry in the same order. Default: https:// plus the relay's
# authority, as for assertions. Each must be in that relay's command_audiences.
BUZZ_RELAY_COMMAND_AUDIENCES=

# Agent grant lifetime in seconds, at most 2592000. Default: 691200 (8 days). A grant is not
# extended by use; the owner enrolls the agent again for a new one.
BUZZ_AGENT_GRANT_TTL_SECONDS=691200

# Agents one user may hold with a live grant (not revoked, not expired).
# Default: 5. Enrolling past it answers 429 rate_limited until the owner revokes
# one or a grant expires; an agent deleted without revoking frees its slot when
# its grant expires. Re-enrolling an expired agent counts against the cap again.
BUZZ_MAX_AGENTS_PER_USER=5

# Accept the agent enrollment form the current buzz-app desktop sends
# (urn:builderlab token types, runtime=local, proof in Nostr-Agent-Proof) as
# well as the NIP-FA spec form. Read only with BUZZ_AGENTS_ENABLED on. Default:
# true. Set false once the desktop build sends the spec form (urn:nostr token
# types and Nostr-Authorization). Any value other than true/false refuses to
# start.
BUZZ_AGENTS_ACCEPT_LEGACY_CLIENT=true

# --- Optional ---------------------------------------------------------------

# Confidential-client secret. Leave empty for public-client mode; when empty the
# service logs a warning at startup and omits client_secret on refresh grants.
OIDC_CLIENT_SECRET=

# Lifetime reported to oauth2-proxy for the issued session, in seconds. Must
# match OAUTH2_PROXY_COOKIE_EXPIRE. Default: 604800 (7 days).
SESSION_COOKIE_MAX_AGE_SECONDS=604800

# When set, /mpass/logout chains through the IdP's sign-out endpoint.
OIDC_LOGOUT_URI=
LOGOUT_REDIRECT_URL=

# When set, only access tokens whose custom:corporate_id claim matches this
# value are accepted. Empty disables the check.
SMB_CORPORATE_ID=

# Overrides the portal URL that user-facing callback failures redirect to.
# Default: MPASS_CALLBACK_URL's host with a leading `auth.` stripped.
PORTAL_URL=

# uvicorn log level — lowercase only (uvicorn rejects uppercase). Default: info.
LOG_LEVEL=info

# Development only. Permits the ephemeral in-memory signing key described above.
# Never set this in staging or production.
MPASS_SIGNING_KEY_ALLOW_EPHEMERAL=false
