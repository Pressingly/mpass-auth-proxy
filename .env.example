# mpass-auth-proxy configuration
# Copy to .env and fill in. Values below are placeholders, not real credentials.
# Angle-bracket placeholders are quoted so this file stays source-able as-is;
# replace the whole value, quotes included, with the real one.

# --- Required ---------------------------------------------------------------

# OIDC issuer. For AWS Cognito this is the user-pool issuer, NOT the OAuth
# domain — the /token endpoint is resolved from the discovery document.
OIDC_ISSUER_URL="https://cognito-idp.<region>.amazonaws.com/<user-pool-id>"

# OIDC client (app client) id registered with the IdP.
OIDC_CLIENT_ID="<client-id>"

# Moneta hosted UI the browser is redirected to for the QR / implicit flow.
MONETA_HOSTED_UI_URL="https://<moneta-hosted-ui-host>"

# Public URL of this service's /mpass-callback endpoint. The host also derives
# the allowed redirect_uri suffix and the portal URL (see PORTAL_URL below).
MPASS_CALLBACK_URL="https://auth.<platform-domain>/mpass-callback"

# Redis / Valkey connection used for bridge state and one-time auth codes.
REDIS_URL=redis://valkey:6379/10

# Cookie domain for the mpass_bridge cookie — must cover every app subdomain.
COOKIE_DOMAIN=".<platform-domain>"

# RSA signing key for the re-signed id_token, read from GCP Secret Manager.
# The service REFUSES TO START without these unless
# MPASS_SIGNING_KEY_ALLOW_EPHEMERAL is set: oauth2-proxy verifies every token
# against this service's JWKS, so a per-process generated key means each restart
# forces a re-login across every app, and a second replica can never verify the
# first's tokens.
MPASS_SIGNING_KEY_GCP_PROJECT="<gcp-project-id>"
MPASS_SIGNING_KEY_GCP_SECRET="<secret-name>"

# Launchpad database, read-only. Used to resolve a synthetic identity to its
# verified real email before the token is re-signed. When this lookup cannot be
# completed the service returns 503 rather than falling back to the synthetic
# address -- see the email-overlay note in main.py for why.
LAUNCHPAD_DB_HOST=postgres
LAUNCHPAD_DB_PORT=5432
LAUNCHPAD_DB_NAME=launchpad
LAUNCHPAD_DB_USER=mpass_auth_user
LAUNCHPAD_DB_PASSWORD=

# Domain of the synthetic address (<synthetic_id>@<domain>) that unverified
# users are identified by. REQUIRED — the service refuses to start without it.
# Not defaulted on purpose: consumers key identity on the email claim, so a
# different value silently turns every user into a new principal and orphans
# their existing data. Set it to the platform's shared email domain.
SYNTHETIC_EMAIL_DOMAIN="<platform-email-domain>"

# --- Optional ---------------------------------------------------------------

# Confidential-client secret. Leave empty for public-client mode; when empty the
# service logs a warning at startup and omits client_secret on refresh grants.
OIDC_CLIENT_SECRET=

# Lifetime reported to oauth2-proxy for the issued session, in seconds. Must
# match OAUTH2_PROXY_COOKIE_EXPIRE. Default: 604800 (7 days).
SESSION_COOKIE_MAX_AGE_SECONDS=604800

# When set, /mpass/logout chains through the IdP's sign-out endpoint.
OIDC_LOGOUT_URI=
LOGOUT_REDIRECT_URL=

# When set, only access tokens whose custom:corporate_id claim matches this
# value are accepted. Empty disables the check.
SMB_CORPORATE_ID=

# Overrides the portal URL that user-facing callback failures redirect to.
# Default: MPASS_CALLBACK_URL's host with a leading `auth.` stripped.
PORTAL_URL=

# uvicorn log level — lowercase only (uvicorn rejects uppercase). Default: info.
LOG_LEVEL=info

# Development only. Permits the ephemeral in-memory signing key described above.
# Never set this in staging or production.
MPASS_SIGNING_KEY_ALLOW_EPHEMERAL=false
