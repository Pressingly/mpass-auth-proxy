# Test environment — fake values only, safe to commit.
# Loaded automatically by pytest-dotenv before any test module is imported.
# Values must match the module-level constants in tests/test_main.py used in assertions.
OIDC_ISSUER_URL=https://test-idp.example.com/pool-id
OIDC_CLIENT_ID=test-client-id
MONETA_HOSTED_UI_URL=https://moneta-ui.example.com
MPASS_CALLBACK_URL=https://test-auth.example.com/mpass-callback
REDIS_URL=redis://localhost:6379/0
COOKIE_DOMAIN=.example.com
SMB_CORPORATE_ID=

# main.py refuses to start on an ephemeral signing key outside development.
# The suite has no GCP Secret Manager access, so opt in here.
MPASS_SIGNING_KEY_ALLOW_EPHEMERAL=true

# Synthetic address domain. A reserved example domain, not the real platform
# one: these tests assert on the exact string, and pinning the production value
# in a suite that is mirrored to a public repository discloses it for no gain.
SYNTHETIC_EMAIL_DOMAIN=synthetic.example.com
