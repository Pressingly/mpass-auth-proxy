# Test environment — fake values only, safe to commit.
# Loaded automatically by pytest-dotenv before any test module is imported.
# Values must match the module-level constants in tests/test_main.py used in assertions.
OIDC_ISSUER_URL=https://test-idp.example.com/pool-id
OIDC_CLIENT_ID=test-client-id
MONETA_HOSTED_UI_URL=https://moneta-ui.example.com
MPASS_CALLBACK_URL=https://test-auth.example.com/mpass-callback
REDIS_URL=redis://localhost:6379/0
COOKIE_DOMAIN=.example.com
SMB_CORPORATE_ID=

# main.py refuses to start on an ephemeral signing key outside development.
# The suite has no GCP Secret Manager access, so opt in here.
MPASS_SIGNING_KEY_ALLOW_EPHEMERAL=true

# Declared empty on purpose. pytest.ini sets env_override_existing_values=1,
# which only overrides keys this file declares -- so without this line, a
# developer who had run `set -a; . ./.env` in the same shell would export a real
# signing key, main.py's import would silently take the MPASS_SIGNING_KEY_B64
# branch instead of the suite's ephemeral default, and the results would differ
# between machines. Declaring it empty also means the whole suite imports
# main.py through the empty-string path, which is the standing regression guard
# for "empty means unset" (a `in os.environ` check would break every test here).
MPASS_SIGNING_KEY_B64=

# Synthetic address domain. A reserved example domain, not the real platform
# one: these tests assert on the exact string, and pinning the production value
# in a suite that is mirrored to a public repository discloses it for no gain.
SYNTHETIC_EMAIL_DOMAIN=synthetic.example.com

# The suite's subject is the email-capture feature, so it runs with the flag on.
# Disabled-path behaviour is covered by tests that patch _EMAIL_CAPTURE_ENABLED
# directly -- the flag is read at import, so setting the env var per-test is a
# no-op.
LAUNCHPAD_EMAIL_CAPTURE=true
LAUNCHPAD_DB_PASSWORD=fake-test-password
